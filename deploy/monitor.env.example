# Опциональный локальный мониторинг на VPS (дополнение к GitHub Actions Uptime).
# Скопируйте в /etc/birzha/monitor.env (chmod 600).

# BIRZHA_HEALTH_URL=http://127.0.0.1:3000/health
# BIRZHA_READY_URL=http://127.0.0.1:3000/health/ready

# Telegram: создайте бота у @BotFather, chat_id — у @userinfobot или getUpdates.
BIRZHA_TELEGRAM_BOT_TOKEN=
BIRZHA_TELEGRAM_CHAT_ID=
