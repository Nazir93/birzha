# Пример переменных для offsite-бэкапов Биржи.
# Скопируйте на VPS в /etc/birzha/backup.env (chmod 600) или добавьте в apps/api/.env.
# Секреты rclone (access key) храните в ~/.config/rclone/rclone.conf — не в git.

# rclone remote:path — бакет/префикс S3-совместимого хранилища.
# Пример Яндекс Object Storage после `rclone config` (remote name = birzha-s3):
#   BIRZHA_BACKUP_RCLONE_REMOTE=birzha-s3:birzha-backups
# Пока не задано — backup-database.sh пишет только локально и логирует SKIP offsite.
BIRZHA_BACKUP_RCLONE_REMOTE=

# Опционально: ping после успешного dump(+upload), например Healthchecks.io.
# BIRZHA_BACKUP_HEALTHCHECK_URL=https://hc-ping.com/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
BIRZHA_BACKUP_HEALTHCHECK_URL=

# Retention (дни); совпадает с дефолтами backup-database.sh.
# BIRZHA_BACKUP_KEEP_DAYS=7
# BIRZHA_BACKUP_KEEP_WEEKLY_DAYS=28
# BIRZHA_BACKUP_KEEP_BEFORE_DAYS=14
